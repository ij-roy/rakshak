{
  "name": "rakshak",
  "version": "1.0.0",
  "private": true,
  "description": "RAKSHAK — Survive the Night",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* run build --if-present && pnpm --filter @rakshak/web run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --if-present run test",
    "lint": "pnpm -r --if-present run lint",
    "validate:content": "pnpm --filter @rakshak/tools-validate run validate:content",
    "validate:licenses": "pnpm --filter @rakshak/tools-validate run validate:licenses",
    "dev:web": "pnpm --filter @rakshak/web dev",
    "dev:mobile": "pnpm --filter @rakshak/mobile start",
    "android": "pnpm --filter @rakshak/mobile android",
    "verify": "pnpm typecheck && pnpm test && pnpm validate:content && pnpm --filter @rakshak/web run build"
  },
  "devDependencies": {
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  }
}